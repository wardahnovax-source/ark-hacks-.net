---
import HomeAboutApp from './react/HomeAbout';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
---

<HomeAboutApp client:visible locale={locale} />

<style is:global>
	.home-about {
		padding-block: clamp(2.25rem, 4.5vw, 3.25rem) clamp(1.5rem, 3vw, 2rem);
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__head {
		max-width: 42rem;
		margin-bottom: 1.35rem;
	}

	.home-about__eyebrow {
		margin: 0 0 0.45rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.home-about__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3.2vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.15;
		background: linear-gradient(135deg, var(--ink) 0%, var(--accent-hover) 55%, var(--accent) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	@supports not (background-clip: text) {
		.home-about__title {
			color: var(--accent-hover);
			background: none;
		}
	}

	.home-about__lede {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-bottom: 1.35rem;
	}

	.home-about__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 1rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.home-about__cta--primary {
		background: var(--accent);
		color: #0a0a0a;
		border: 1px solid color-mix(in srgb, var(--accent) 70%, white);
	}

	.home-about__cta--primary:hover {
		background: var(--accent-hover);
		transform: translateY(-1px);
	}

	.home-about__cta--ghost {
		background: transparent;
		color: var(--accent-hover);
		border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
	}

	.home-about__cta--ghost:hover {
		border-color: var(--accent);
		color: var(--ink);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	.home-about__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	.home-about__card {
		position: relative;
		display: grid;
		gap: 0.2rem;
		padding: 0.95rem 2.4rem 0.95rem 1rem;
		border-radius: 0.85rem;
		border: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--bg-elevated) 88%, var(--accent) 4%);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.home-about__card:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		background: color-mix(in srgb, var(--bg-elevated) 70%, var(--accent) 10%);
		transform: translateY(-1px);
	}

	.home-about__card-label {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--ink);
	}

	.home-about__card-hint {
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.home-about__card-arrow {
		position: absolute;
		top: 50%;
		right: 1rem;
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid var(--accent);
		border-bottom: 2px solid var(--accent);
		transform: translateY(-50%) rotate(-45deg);
		opacity: 0.85;
		transition: right 0.15s ease;
	}

	.home-about__card:hover .home-about__card-arrow {
		opacity: 1;
		right: 0.85rem;
	}

	@media (min-width: 640px) {
		.home-about__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 960px) {
		.home-about__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
